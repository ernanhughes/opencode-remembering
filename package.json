{
  "name": "opencode-remembering",
  "version": "0.0.1",
  "description": "OpenCode plugin for Project Memory with replaceable storage (PostgreSQL/pgvector, HTTP REST/RPC, or local JSON fallback).",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/index.js"
  },
  "files": [
    "dist",
    "remembering.example.json",
    "sql/remembering-http-v1.sql"
  ],
  "scripts": {
    "build": "bun build ./index.ts --outdir ./dist --target node --format esm --packages external",
    "prepack": "bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test",
    "doctor": "bun src/dev-cli.ts doctor",
    "setup": "bun src/dev-cli.ts setup",
    "refresh": "bun src/dev-cli.ts refresh",
    "route-eval": "bun src/dev-cli.ts route-eval",
    "temporal-import": "bun src/dev-cli.ts temporal-import",
    "temporal-state": "bun src/dev-cli.ts temporal-state",
    "temporal-eval": "bun src/dev-cli.ts temporal-eval",
    "frame-health": "bun src/dev-cli.ts frame-health",
    "frame-eval": "bun src/dev-cli.ts frame-eval",
    "trust-health": "bun src/dev-cli.ts trust-health",
    "trust-import": "bun src/dev-cli.ts trust-import",
    "trust-eval": "bun src/dev-cli.ts trust-eval",
    "selection-eval": "bun src/dev-cli.ts selection-eval",
    "trace-eval": "bun src/dev-cli.ts trace-eval",
    "loop-health": "bun src/dev-cli.ts loop-health",
    "loop-import": "bun src/dev-cli.ts loop-import",
    "loop-eval": "bun src/dev-cli.ts loop-eval",
    "write-health": "bun src/dev-cli.ts write-health",
    "write-eval": "bun src/dev-cli.ts write-eval",
    "write-rebuild": "bun src/dev-cli.ts write-rebuild",
    "native:doctor": "bun src/native-cli.ts doctor",
    "native:setup": "bun src/native-cli.ts setup",
    "native:refresh": "bun src/native-cli.ts refresh",
    "native:search": "bun src/native-cli.ts search"
  },
  "dependencies": {
    "@opencode/plugin": "^2.0.12"
  },
  "optionalDependencies": {
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@tsconfig/bun": "^1.0.10",
    "@types/bun": "^1.3.3",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.11.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
