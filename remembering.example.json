{
  "dsn": "postgresql://postgres:<password>@localhost:5432/memory_baseline",
  "storage": {
    "mode": "auto",
    "postgres": {
      "dsn": "postgresql://postgres:<password>@localhost:5432/memory_baseline"
    },
    "http": {
      "url": null,
      "token_env": "REMEMBERING_HTTP_TOKEN",
      "timeout_ms": 15000
    },
    "json": {
      "path": ".remembering/store"
    }
  },
  "embedding": {
    "provider": "ollama",
    "model": "bge-m3",
    "host": "http://localhost:11434",
    "auth_token_env": "REMEMBERING_EMBEDDING_AUTH_TOKEN"
  },
  "retrieval": {
    "mode": "hybrid",
    "lexical_k": 30,
    "dense_k": 30,
    "fusion_k": 60,
    "rerank_k": 8,
    "reranker": "none"
  },
  "context": {
    "auto_inject": true,
    "max_chars": 4000,
    "max_results": 6
  }
}
